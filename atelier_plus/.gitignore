# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec.lock

# Fichiers générés (Drift, json_serializable, etc.)
**/*.g.dart
**/*.drift.dart

# Secrets Supabase — ne jamais commiter les clés
.env
dart_define.json
*.dart_define.json

# Signature de la version "release" Android — ne jamais commiter : le
# fichier .jks et son mot de passe permettent de publier des mises à jour
# de l'application sous l'identité de l'atelier (voir le commentaire dans
# android/app/build.gradle.kts).
android/key.properties
*.jks
*.keystore

# IDE
.idea/
.vscode/
*.iml

# Divers OS
.DS_Store
