-- Base locale (source de vérité de l'interface). Les tables « miroir »
-- reprennent les noms et colonnes du serveur (sous-ensemble utile au téléphone).
-- Dates et horodatages : texte ISO 8601 (identique au JSON du serveur).

CREATE TABLE schools (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  commune TEXT,
  departement TEXT,
  province TEXT,
  region TEXT,
  school_type TEXT NOT NULL DEFAULT 'publique',
  phone TEXT,
  email TEXT,
  address TEXT,
  director_name TEXT,
  manages_primary BOOLEAN NOT NULL DEFAULT TRUE,
  grading_scale REAL NOT NULL DEFAULT 10,
  show_race_religion BOOLEAN NOT NULL DEFAULT FALSE,
  absent_rule TEXT NOT NULL DEFAULT 'non_compte',
  current_school_year_id TEXT,
  director_civility TEXT,
  director_grade TEXT,
  preschool_ranking BOOLEAN NOT NULL DEFAULT FALSE,
  logo_path TEXT,
  storage_quota_bytes INTEGER NOT NULL DEFAULT 5368709120,
  library_teacher_mode TEXT NOT NULL DEFAULT 'validation',
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS SchoolRow;

CREATE TABLE school_years (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  label TEXT NOT NULL,
  starts_on TEXT,
  ends_on TEXT,
  archived_at TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS SchoolYearRow;

CREATE TABLE admin_headers (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  country TEXT NOT NULL DEFAULT 'BURKINA FASO',
  motto TEXT,
  ministry TEXT,
  region TEXT,
  regional_direction TEXT,
  provincial_direction TEXT,
  ceb TEXT,
  province TEXT,
  departement TEXT,
  commune TEXT,
  school_label TEXT,
  emblem_path TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS AdminHeaderRow;

CREATE TABLE modules_catalog (
  "key" TEXT NOT NULL PRIMARY KEY,
  label TEXT NOT NULL,
  description TEXT NOT NULL,
  depends_on TEXT,
  sort_order INTEGER NOT NULL DEFAULT 0
) AS ModuleCatalogRow;

CREATE TABLE school_modules (
  school_id TEXT NOT NULL,
  module_key TEXT NOT NULL,
  enabled BOOLEAN NOT NULL DEFAULT FALSE,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  synced_at TEXT,
  PRIMARY KEY (school_id, module_key)
) AS SchoolModuleRow;

CREATE TABLE memberships (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  user_id TEXT NOT NULL,
  role TEXT NOT NULL,
  teacher_id TEXT,
  display_name TEXT NOT NULL,
  phone TEXT,
  active BOOLEAN NOT NULL DEFAULT TRUE,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS MembershipRow;

CREATE TABLE delegate_permissions (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  membership_id TEXT NOT NULL,
  permission_key TEXT NOT NULL,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS DelegatePermissionRow;

-- Téléphones de l'école (lecture seule ; le directeur les voit tous).
CREATE TABLE devices (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  user_id TEXT,
  label TEXT NOT NULL,
  series_code TEXT NOT NULL,
  last_seen_at TEXT,
  last_sync_at TEXT,
  pending_count INTEGER NOT NULL DEFAULT 0,
  app_version TEXT,
  revoked_at TEXT,
  created_at TEXT,
  updated_at TEXT,
  deleted_at TEXT,
  synced_at TEXT
) AS DeviceRow;

-- Journal d'activité (lecture seule, directeur uniquement).
CREATE TABLE audit_log (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL,
  actor_id TEXT,
  "action" TEXT NOT NULL,
  table_name TEXT AS affectedTable,
  row_id TEXT,
  details TEXT,
  synced_at TEXT
) AS AuditRow;

-- ------------------------- Phase 2 : personnel, classes, élèves ----

-- Référentiel des niveaux (lecture seule).
CREATE TABLE levels (
  code TEXT NOT NULL PRIMARY KEY,
  cycle TEXT NOT NULL,
  label TEXT NOT NULL,
  sort_order INTEGER NOT NULL
) AS LevelRow;

-- Fiche enseignant (B1, B3) : directeur et délégué « registres ».
CREATE TABLE teachers (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  last_name TEXT NOT NULL,
  first_names TEXT NOT NULL,
  sex TEXT,
  matricule TEXT,
  phone TEXT,
  birth_date TEXT,
  birth_place TEXT,
  emploi TEXT,
  categorie TEXT,
  echelon TEXT,
  tenure_status TEXT,
  status TEXT NOT NULL DEFAULT 'actif',
  commune_nomination_date TEXT,
  first_teaching_nomination_date TEXT,
  pupil_school_name TEXT,
  pupil_school_entry_date TEXT,
  pupil_school_exit_date TEXT,
  seniority_general_from TEXT,
  seniority_emploi_from TEXT,
  seniority_region_from TEXT,
  seniority_fonction_from TEXT,
  commune_cessation_date TEXT,
  new_post TEXT,
  observations TEXT,
  assignment_decision_number TEXT,
  assignment_decision_date TEXT,
  service_start_date TEXT,
  archived_at TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS TeacherRow;

-- B3 col. 8 à 11 : historiques (plusieurs lignes par enseignant).
CREATE TABLE teacher_postings (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  teacher_id TEXT NOT NULL,
  commune TEXT NOT NULL,
  nominated_on TEXT,
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS TeacherPostingRow;

CREATE TABLE teacher_interruptions (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  teacher_id TEXT NOT NULL,
  cause TEXT NOT NULL,
  starts_on TEXT,
  ends_on TEXT,
  duration_text TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS TeacherInterruptionRow;

CREATE TABLE teacher_awards (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  teacher_id TEXT NOT NULL,
  label TEXT NOT NULL,
  awarded_on TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS TeacherAwardRow;

CREATE TABLE teacher_diplomas (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  teacher_id TEXT NOT NULL,
  nature TEXT NOT NULL,
  delivered_on TEXT,
  is_academic BOOLEAN NOT NULL DEFAULT FALSE,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS TeacherDiplomaRow;

CREATE TABLE classes (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  level_code TEXT NOT NULL,
  name TEXT NOT NULL,
  main_teacher_id TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS ClassRow;

-- B1 « Service/classe tenue » et « Fonction », par année.
CREATE TABLE teacher_year_assignments (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  teacher_id TEXT NOT NULL,
  class_id TEXT,
  service_label TEXT,
  fonction TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS TeacherAssignmentRow;

-- Fiche élève (lue aussi par l'enseignant de la classe).
CREATE TABLE students (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  last_name TEXT NOT NULL,
  first_names TEXT NOT NULL,
  sex TEXT,
  birth_date TEXT,
  birth_place TEXT,
  student_code TEXT,
  registry_number INTEGER,
  registry_provisional TEXT,
  domicile TEXT,
  entry_date TEXT,
  exit_date TEXT,
  observations TEXT,
  photo_path TEXT,
  photo_updated_at TEXT,
  archived_at TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS StudentRow;

-- Registre matricule et fiche de scolarité (B2, B4) : jamais l'enseignant.
CREATE TABLE student_registry (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  origin_school TEXT,
  destination TEXT,
  exit_reason TEXT,
  cep_date TEXT,
  diplomas TEXT,
  director_observations TEXT,
  registry_observations TEXT,
  race TEXT,
  religion TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS StudentRegistryRow;

CREATE TABLE guardians (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  relation TEXT NOT NULL,
  full_name TEXT NOT NULL,
  profession TEXT,
  domicile TEXT,
  address TEXT,
  phone TEXT,
  is_lodger BOOLEAN NOT NULL DEFAULT FALSE,
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS GuardianRow;

CREATE TABLE enrollments (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  class_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  level_code TEXT NOT NULL,
  starts_on TEXT,
  ends_on TEXT,
  end_reason TEXT,
  is_repeat BOOLEAN NOT NULL DEFAULT FALSE,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS EnrollmentRow;

-- Formulaires officiels : paramètres d'impression et état (17.3).
CREATE TABLE official_forms (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  form_code TEXT NOT NULL,
  student_id TEXT,
  status TEXT NOT NULL DEFAULT 'a_completer',
  reference_date TEXT,
  register_period_from TEXT,
  register_period_to TEXT,
  signed_place TEXT,
  signed_on TEXT,
  director_name TEXT,
  locked_version INTEGER,
  signed_scan_document_id TEXT,
  show_objective_average BOOLEAN NOT NULL DEFAULT FALSE,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS OfficialFormRow;

-- ------------------------- Phase 3 : notes ---------------------------

CREATE TABLE subjects (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  name TEXT NOT NULL,
  cycle TEXT NOT NULL DEFAULT 'primaire',
  sort_order INTEGER NOT NULL DEFAULT 0,
  default_coefficient REAL NOT NULL DEFAULT 1,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS SubjectRow;

-- Matières d'une classe et leur coefficient.
CREATE TABLE class_subjects (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  class_id TEXT NOT NULL,
  subject_id TEXT NOT NULL,
  coefficient REAL NOT NULL DEFAULT 1,
  teacher_id TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS ClassSubjectRow;

-- Compositions (et autres évaluations) d'une classe, avec leur barème.
CREATE TABLE assessments (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  class_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  label TEXT NOT NULL,
  kind TEXT NOT NULL DEFAULT 'composition',
  sequence INTEGER NOT NULL DEFAULT 1,
  held_on TEXT,
  max_score REAL NOT NULL DEFAULT 10,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS AssessmentRow;

-- Une note = (composition, élève, matière) ; identifiant déterministe pour
-- que deux téléphones hors ligne écrivent la même ligne.
CREATE TABLE grades (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  assessment_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  subject_id TEXT NOT NULL,
  score REAL,
  status TEXT NOT NULL DEFAULT 'note',
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS GradeRow;

CREATE INDEX grades_assessment ON grades (assessment_id);

CREATE TABLE mention_scales (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  min_average REAL NOT NULL,
  max_average REAL NOT NULL,
  label TEXT NOT NULL,
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS MentionScaleRow;

-- Moyenne générale annuelle, rang et effectif (fiche de scolarité).
CREATE TABLE annual_results (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  class_id TEXT,
  level_code TEXT NOT NULL,
  attempt INTEGER NOT NULL DEFAULT 1,
  result_date TEXT,
  general_average REAL,
  rank INTEGER,
  rank_ex_aequo BOOLEAN NOT NULL DEFAULT FALSE,
  class_size INTEGER,
  decision TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS AnnualResultRow;

-- ------------------------- Phase 4 : bulletins, fiche de scolarité ----

-- Modèle de bulletin de l'école (réglages en JSON).
CREATE TABLE report_templates (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  name TEXT NOT NULL,
  settings TEXT NOT NULL DEFAULT '{}',
  is_default BOOLEAN NOT NULL DEFAULT FALSE,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS ReportTemplateRow;

-- Bulletin d'un élève : trimestre (composition du trimestre) ou année
-- (assessment_id nul).
CREATE TABLE report_cards (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  class_id TEXT NOT NULL,
  assessment_id TEXT,
  template_id TEXT,
  teacher_appreciation TEXT,
  director_observation TEXT,
  decision TEXT,
  status TEXT NOT NULL DEFAULT 'brouillon',
  generated_at TEXT,
  pdf_path TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS ReportCardRow;

-- Journal des fiches de scolarité générées (ajout seul).
CREATE TABLE scolarity_copy_log (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  form_version_id TEXT,
  is_certified_copy BOOLEAN NOT NULL,
  generated_by TEXT,
  generated_at TEXT,
  updated_at TEXT NOT NULL,
  synced_at TEXT
) AS ScolarityCopyRow;

CREATE INDEX report_cards_class ON report_cards (class_id);

-- A17 : documents délivrés par le directeur (ajout seul, sans numéro).
CREATE TABLE issued_documents (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  school_year_id TEXT,
  doc_code TEXT NOT NULL,
  student_id TEXT,
  teacher_id TEXT,
  generated_by TEXT,
  generated_at TEXT,
  updated_at TEXT NOT NULL,
  synced_at TEXT
) AS IssuedDocumentRow;

-- ---------------- Phase 5 : programme (B6) et bilan (B7) ----------------

-- Un seul jeu de lignes « objectif → activités » pour B6 et B7.
CREATE TABLE activity_objectives (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  order_no INTEGER NOT NULL,
  label TEXT NOT NULL,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS ActivityObjectiveRow;

CREATE TABLE activity_lines (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  objective_id TEXT NOT NULL,
  sort_order INTEGER NOT NULL DEFAULT 0,
  planned_activity TEXT NOT NULL,
  deadline_on TEXT,
  deadline_text TEXT,
  constraint_text TEXT,
  expected_result TEXT,
  achieved_result TEXT,
  success_rate REAL,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS ActivityLineRow;

-- Versions imprimées (instantanés, ajout seul ; la finale est verrouillée).
CREATE TABLE form_versions (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  form_id TEXT NOT NULL,
  version_no INTEGER NOT NULL,
  is_final BOOLEAN NOT NULL DEFAULT FALSE,
  is_certified_copy BOOLEAN NOT NULL DEFAULT FALSE,
  snapshot TEXT NOT NULL DEFAULT '{}',
  pdf_path TEXT,
  created_by TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  synced_at TEXT
) AS FormVersionRow;

-- ---------------- Phase 6 : maternelle (module optionnel) ----------------

CREATE TABLE learning_domains (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  name TEXT NOT NULL,
  sort_order INTEGER NOT NULL DEFAULT 0,
  active BOOLEAN NOT NULL DEFAULT TRUE,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS LearningDomainRow;

-- Niveaux qualitatifs : couleur ET pictogramme.
CREATE TABLE qualitative_levels (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  code TEXT NOT NULL,
  label TEXT NOT NULL,
  color_hex TEXT NOT NULL,
  icon_key TEXT NOT NULL,
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS QualitativeLevelRow;

CREATE TABLE preschool_periods (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  class_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  label TEXT NOT NULL,
  sequence INTEGER NOT NULL DEFAULT 1,
  ends_on TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS PreschoolPeriodRow;

CREATE TABLE preschool_evaluations (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  period_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  domain_id TEXT NOT NULL,
  level_id TEXT NOT NULL,
  comment TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS PreschoolEvaluationRow;

CREATE TABLE preschool_booklets (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  period_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  teacher_appreciation TEXT,
  observation TEXT,
  status TEXT NOT NULL DEFAULT 'brouillon',
  pdf_path TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS PreschoolBookletRow;

-- Présences (classes de maternelle en phase 6 ; primaire en phase 13).
CREATE TABLE attendance (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  class_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  day TEXT NOT NULL,
  status TEXT NOT NULL,
  reason TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS AttendanceRow;

-- ---------------- Phase 8 : cartes scolaires ----------------

CREATE TABLE card_templates (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  name TEXT NOT NULL,
  primary_color TEXT NOT NULL DEFAULT '#1B6E3C',
  secondary_color TEXT NOT NULL DEFAULT '#FFFFFF',
  is_default BOOLEAN NOT NULL DEFAULT FALSE,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS CardTemplateRow;

-- Le QR code ne contient que qr_token (identifiant opaque aléatoire).
CREATE TABLE student_cards (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  qr_token TEXT NOT NULL,
  generated_at TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS StudentCardRow;

-- ---------------- Phase 9 : bibliothèque et archives ----------------

-- Catalogue (fiches) : disponible hors ligne ; les fichiers ne sont jamais
-- téléchargés automatiquement (document_files).
CREATE TABLE documents (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  space TEXT NOT NULL,
  title TEXT NOT NULL,
  is_common BOOLEAN NOT NULL DEFAULT FALSE,
  subject_id TEXT,
  doc_type TEXT,
  school_year_id TEXT,
  source_author TEXT,
  keywords TEXT NOT NULL DEFAULT '[]',
  class_ids TEXT NOT NULL DEFAULT '[]',
  level_codes TEXT NOT NULL DEFAULT '[]',
  storage_path TEXT,
  original_name TEXT,
  mime_type TEXT,
  size_bytes INTEGER,
  sha256 TEXT,
  page_count INTEGER,
  ai_allowed BOOLEAN NOT NULL DEFAULT TRUE,
  is_sensitive BOOLEAN NOT NULL DEFAULT FALSE,
  index_status TEXT NOT NULL DEFAULT 'en_attente',
  index_error TEXT,
  approved BOOLEAN NOT NULL DEFAULT TRUE,
  trashed_at TEXT,
  uploaded_by TEXT,
  uploaded_at TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS DocumentRow;

-- File d'envoi des fichiers (reprenable) : la position est gardée après
-- chaque morceau.
CREATE TABLE document_uploads (
  document_id TEXT NOT NULL PRIMARY KEY,
  local_path TEXT NOT NULL,
  object_path TEXT NOT NULL,
  content_type TEXT NOT NULL,
  size_bytes INTEGER NOT NULL,
  sent_bytes INTEGER NOT NULL DEFAULT 0,
  upload_url TEXT,
  attempts INTEGER NOT NULL DEFAULT 0,
  last_error TEXT,
  created_at TEXT NOT NULL
) AS DocumentUploadRow;

-- Fichiers présents sur ce téléphone (épinglés ou ouverts récemment).
CREATE TABLE document_files (
  document_id TEXT NOT NULL PRIMARY KEY,
  local_path TEXT NOT NULL,
  size_bytes INTEGER NOT NULL,
  pinned BOOLEAN NOT NULL DEFAULT FALSE,
  saved_at TEXT NOT NULL
) AS DocumentFileRow;

CREATE INDEX preschool_evaluations_period ON preschool_evaluations (period_id);
CREATE INDEX attendance_class_day ON attendance (class_id, day);

CREATE INDEX activity_lines_objective ON activity_lines (objective_id);

CREATE INDEX enrollments_class ON enrollments (class_id);
CREATE INDEX enrollments_student ON enrollments (student_id);

-- ------------------------- Tables locales ---------------------------

-- File d'envoi : une entrée par ligne modifiée (les modifications successives
-- d'une même ligne non encore envoyée sont fusionnées ; « revision » change).
CREATE TABLE outbox (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  target_table TEXT NOT NULL,
  row_key TEXT NOT NULL,
  payload TEXT NOT NULL,
  revision INTEGER NOT NULL DEFAULT 1,
  status TEXT NOT NULL DEFAULT 'en_attente',
  message TEXT,
  attempts INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
) AS OutboxEntry;

CREATE TABLE sync_cursors (
  target_table TEXT NOT NULL PRIMARY KEY,
  synced_at TEXT NOT NULL,
  tie TEXT NOT NULL DEFAULT ''
) AS SyncCursor;

CREATE TABLE local_session (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  user_id TEXT NOT NULL,
  login TEXT NOT NULL,
  membership_id TEXT NOT NULL,
  school_id TEXT NOT NULL,
  role TEXT NOT NULL,
  display_name TEXT NOT NULL,
  device_id TEXT NOT NULL,
  device_series TEXT,
  clock_offset_ms INTEGER NOT NULL DEFAULT 0,
  last_sync_at TEXT,
  journal_seen_at TEXT
) AS LocalSessionRow;

-- Brouillons des formulaires (sauvegarde automatique ; jamais de mot de passe).
CREATE TABLE drafts (
  "key" TEXT NOT NULL PRIMARY KEY,
  payload TEXT NOT NULL,
  updated_at TEXT NOT NULL
) AS DraftRow;

-- Fichiers à envoyer (image d'en-tête…), envoyés dès que le réseau revient.
CREATE TABLE file_uploads (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  local_path TEXT NOT NULL,
  bucket TEXT NOT NULL,
  object_path TEXT NOT NULL,
  content_type TEXT NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
) AS FileUploadRow;

-- Identité de ce téléphone (conservée même quand on change de compte).
CREATE TABLE device_identity (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  device_id TEXT NOT NULL,
  -- Message à montrer à l'ouverture (ex. téléphone déconnecté par le directeur).
  notice TEXT
) AS DeviceIdentityRow;

-- Verrouillage de l'application (code PIN, empreinte). Jamais le code en clair.
CREATE TABLE app_lock (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  pin_hash TEXT NOT NULL,
  pin_salt TEXT NOT NULL,
  iterations INTEGER NOT NULL,
  biometric BOOLEAN NOT NULL DEFAULT FALSE,
  failed_attempts INTEGER NOT NULL DEFAULT 0,
  blocked_until TEXT
) AS AppLockRow;

-- ---------------- Phase 10 : finances (hors cantine) ----------------
-- Montants en FCFA (entiers). Grille, échéancier, remises : modifiables.
-- Encaissements, dépenses, clôtures : en AJOUT SEUL (jamais modifiés ni
-- supprimés ; une erreur se corrige par une annulation motivée).

CREATE TABLE fee_items (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  rubric TEXT NOT NULL,
  label TEXT NOT NULL,
  -- null = tous les niveaux ; class_id renseigné = tarif propre à la classe.
  level_code TEXT,
  class_id TEXT,
  billing_period TEXT NOT NULL DEFAULT 'unique',
  amount INTEGER NOT NULL,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS FeeItemRow;

CREATE TABLE fee_installments (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  fee_item_id TEXT NOT NULL,
  label TEXT NOT NULL,
  due_on TEXT,
  amount INTEGER NOT NULL,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS FeeInstallmentRow;

CREATE TABLE discounts (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  label TEXT NOT NULL,
  kind TEXT NOT NULL,
  value REAL NOT NULL,
  rubric TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS DiscountRow;

CREATE TABLE student_discounts (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  student_id TEXT NOT NULL,
  discount_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  fee_item_id TEXT,
  created_at TEXT,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  synced_at TEXT
) AS StudentDiscountRow;

CREATE TABLE payments (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  student_id TEXT,
  rubric TEXT NOT NULL,
  fee_item_id TEXT,
  amount INTEGER NOT NULL,
  method TEXT NOT NULL,
  reference TEXT,
  payer_name TEXT,
  paid_at TEXT NOT NULL,
  received_by TEXT,
  device_id TEXT NOT NULL,
  device_seq INTEGER NOT NULL,
  receipt_number TEXT NOT NULL,
  reverses_payment_id TEXT,
  reversal_reason TEXT,
  created_at TEXT,
  -- Absente sur le serveur (ajout seul) : vide pour les lignes reçues.
  updated_at TEXT NOT NULL DEFAULT '',
  synced_at TEXT
) AS PaymentRow;

CREATE TABLE expenses (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  school_year_id TEXT NOT NULL,
  category TEXT NOT NULL,
  label TEXT NOT NULL,
  amount INTEGER NOT NULL,
  spent_on TEXT NOT NULL,
  method TEXT,
  justification_path TEXT,
  device_id TEXT NOT NULL,
  device_seq INTEGER NOT NULL,
  voucher_number TEXT,
  reverses_expense_id TEXT,
  reversal_reason TEXT,
  created_by TEXT,
  created_at TEXT,
  -- Absente sur le serveur (ajout seul) : vide pour les lignes reçues.
  updated_at TEXT NOT NULL DEFAULT '',
  synced_at TEXT
) AS ExpenseRow;

CREATE TABLE cash_closings (
  id TEXT NOT NULL PRIMARY KEY,
  school_id TEXT NOT NULL,
  period_month TEXT NOT NULL,
  closing_balance INTEGER NOT NULL,
  closed_by TEXT,
  notes TEXT,
  created_at TEXT,
  -- Absente sur le serveur (ajout seul) : vide pour les lignes reçues.
  updated_at TEXT NOT NULL DEFAULT '',
  synced_at TEXT
) AS CashClosingRow;

CREATE INDEX payments_student ON payments (student_id, school_year_id);
CREATE INDEX payments_device ON payments (device_id, school_year_id, device_seq);
