# Copier en .env (jamais committé), puis : flutter run --dart-define-from-file=.env
# Valeurs locales : `npx supabase status`. Depuis l'émulateur Android, le
# serveur local s'appelle 10.0.2.2 (et non 127.0.0.1).
SUPABASE_URL=http://10.0.2.2:54321
SUPABASE_ANON_KEY=
# Côté serveur uniquement (Edge Functions) — jamais dans l'application :
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
OCR_PROVIDER=tesseract
